# ============================================================
# .env.example
# Copiar como .env y completar con valores reales.
# NUNCA commitear .env al repositorio.
# ============================================================

# SAP HANA — origen
HANA_HOST=MI_SERVIDOR_HANA
HANA_PORT=30015
HANA_DATABASE=MI_DATABASE
HANA_USERNAME=mi_usuario
HANA_PASSWORD=mi_password

# SAP HANA — origen 2 / desarrollo (source_name: hanadev)
HANADEV_HOST=MI_SERVIDOR_HANA_DEV
HANADEV_PORT=30015
HANADEV_DATABASE=MI_DATABASE_DEV
HANADEV_USERNAME=mi_usuario
HANADEV_PASSWORD="mi_password"

# MySQL — destino (capa RAW). target_schema "raw" = base `raw`
DESTINATION_HOST=vivawell-powerbi.cefdlqhdpnun.us-east-1.rds.amazonaws.com
DESTINATION_PORT=3306
DESTINATION_DATABASE=raw
DESTINATION_USERNAME=mi_usuario
DESTINATION_PASSWORD="mi_password#123"    # comillas dobles si tiene caracteres especiales como #
# DESTINATION_SSL_CA=C:\certs\global-bundle.pem   # opcional, CA de RDS si se exige SSL
# AUDIT_DATABASE=monitor                          # opcional, base para pipeline_runs (default: la destino)

# PostgreSQL — origen
POSTGRES_HOST=MI_SERVIDOR_POSTGRES
POSTGRES_PORT=5432
POSTGRES_DATABASE=cube
POSTGRES_USERNAME=mi_usuario
POSTGRES_PASSWORD=mi_password

# Oracle — origen
ORACLE_HOST=MI_SERVIDOR_ORACLE
ORACLE_PORT=1521
ORACLE_DATABASE=MI_SERVICE_NAME
ORACLE_USERNAME=mi_usuario
ORACLE_PASSWORD=mi_password
ORACLE_CLIENT_DIR=C:\oracle\instantclient_23_26

# SQL Server — origen 1 (source_name: sqlserver)
SQLSERVER_HOST=MI_SERVIDOR1
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=MI_BASE1
SQLSERVER_USERNAME=mi_usuario1
SQLSERVER_PASSWORD="mi_password#1"     # comillas dobles si tiene caracteres especiales como #
# SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server    # opcional, se autodetecta

# SQL Server — origen 2 (source_name: sqlserver2)
SQLSERVER2_HOST=MI_SERVIDOR2
SQLSERVER2_PORT=1433
SQLSERVER2_DATABASE=MI_BASE2
SQLSERVER2_USERNAME=mi_usuario2
SQLSERVER2_PASSWORD="mi_password#2"    # comillas dobles si tiene caracteres especiales como #
# SQLSERVER2_DRIVER=ODBC Driver 17 for SQL Server   # opcional, se autodetecta

# SQL Server — origen 3 (source_name: sqlserver3)
SQLSERVER3_HOST=MI_SERVIDOR3
SQLSERVER3_PORT=1433
SQLSERVER3_DATABASE=MI_BASE3
SQLSERVER3_USERNAME=mi_usuario3
SQLSERVER3_PASSWORD="mi_password#3"    # comillas dobles si tiene caracteres especiales como #
# SQLSERVER3_DRIVER=ODBC Driver 17 for SQL Server   # opcional, se autodetecta


# SharePoint Online — origen (source_name: sharepoint)
# Requiere una app registrada en Entra ID con permiso Sites.Read.All (Application)
SHAREPOINT_TENANT_ID=00000000-0000-0000-0000-000000000000
SHAREPOINT_CLIENT_ID=00000000-0000-0000-0000-000000000000
SHAREPOINT_CLIENT_SECRET="mi_client_secret"
SHAREPOINT_HOST=miempresa.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/PowerBI
# SHAREPOINT_DRIVE_NAME=Documentos    # opcional, por defecto la primera biblioteca
